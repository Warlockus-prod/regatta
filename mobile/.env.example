# PostHog product analytics (PUBLIC values - safe to ship in the client).
#
# Two ways to provide the key, pick ONE:
#   1. app.json -> expo.extra.posthogKey  (committed default, recommended)
#   2. a local .env with the vars below   (overrides app.json at build time)
#
# When no key is set, analytics stays OFF and the app runs normally.
#
# Get the Project API key from PostHog: Settings -> Project -> Project API Key
# (starts with "phc_"). Pick the host that matches your project's region.

EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
